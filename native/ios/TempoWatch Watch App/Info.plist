<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Ronda</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array><string>en</string><string>sv</string></array>
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>app.ronda.timer</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>
	<key>WKBackgroundModes</key>
	<array><string>workout-processing</string></array>
	<key>NSHealthShareUsageDescription</key>
	<string>Ronda reads your heart rate to show live heart-rate zones during workouts. Your data stays on your devices.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Ronda saves finished workouts, heart rate and active calories to Apple Health so you can see them with the rest of your activity.</string>
</dict>
</plist>
